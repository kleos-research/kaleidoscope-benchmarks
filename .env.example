# ---- BEAM ----

# Required. Any OpenAI-compatible key.
OPENAI_API_KEY=sk-...

# Optional. Point at any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Which model does what. Keep the reader identical across arms you intend to
# compare — a reader difference is indistinguishable from a memory difference.
KBENCH_EXTRACTOR_MODEL=gpt-4.1
KBENCH_READER_MODEL=gpt-4.1
KBENCH_JUDGE_MODEL=gpt-4.1

# Concurrency. Conversations are independent stores, so this is free
# parallelism. Total in-flight work is conversations x questions.
KBENCH_CONVERSATION_WORKERS=4
KBENCH_QUESTION_WORKERS=4
KBENCH_JUDGE_WORKERS=8

# ---- MemoryAgentBench ----

# Its model calls go to Azure OpenAI, to a deployment named gpt-5.6-luna.
# Uncomment and fill in both lines to run it.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
