index 0000000..c48e0c1
--- /dev/null
+++ b/memory/memory_systems/kscope_memory.py
@@ -0,0 +1,291 @@
+"""Kaleidoscope (`kscope`) memory adapter for MemoryArena: one class, one `writer` switch.
+
+`writer="kscope"`  the write door turns each chunk into a structured delta (one LLM call,
+                   `common/writer.py`) and commits it to a kscope vault AT ONCE -- nothing is
+                   buffered, so nothing can be written with a later question in scope. The read
+                   door is one `kscope search`; every byte served comes out of that response.
+`writer="none"`    the blind control through the same seam: the write door drops the chunk and
+                   the read door returns the same tagged block holding the literal `None`.
+
+Isolation: one vault per `user_id` (run_math.py mints one uuid per paper) at
+`vaults/arena/<run_id>/<writer>/<user_id>`, created in the constructor through
+`common/kscope_io.Vault.create`, which refuses a root outside `vaults/`, refuses the personal
+vault, and refuses to reuse a root that already exists.
+
+The read-door string mirrors `rag.py` exactly. The tags are load-bearing:
+`env/env_systems/math_env.py` recovers the memory block by splitting on them.
+
+Every call appends one JSONL row, with a snapshot of the per-instance counters, to
+`logs/arena_adapter-<run_id>.jsonl`.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import sys
+import time
+import unicodedata
+from collections import Counter
+from pathlib import Path
+from typing import List, Optional, Tuple
+
+# <bench>/MemoryArena/memory/memory_systems/kscope_memory.py -> <bench>
+BENCH_ROOT = Path(os.environ.get("BENCH_ROOT") or Path(__file__).resolve().parents[3])
+if not (BENCH_ROOT / "common" / "kscope_io.py").is_file():
+    raise ImportError(f"kscope adapter: {BENCH_ROOT}/common is missing; set BENCH_ROOT")
+if str(BENCH_ROOT) not in sys.path:
+    sys.path.insert(0, str(BENCH_ROOT))
+
+from common import kscope_io, llm  # noqa: E402
+from common import writer as delta_writer  # noqa: E402
+
+_SAFE_COMPONENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
+# The query bound is read out of the binary's own refusal, never written down here.
+_QUERY_BOUND = re.compile(r"over the (\d+)-byte bound")
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
+
+
+def fallback_delta(unit: str) -> dict:
+    """The smallest delta `remember` accepts. It says nothing about the unit's content on
+    purpose: it exists so a chunk the writer could not structure is still stored verbatim
+    (and still reachable through the content channels) instead of being dropped."""
+    first = next((line.strip() for line in unit.splitlines() if line.strip()), "")
+    return {
+        "memory_type": "note",
+        "title": (first or "unstructured record")[:160],
+        "facts": [{"subject": "agent record", "predicate": "instance_of", "object": "unstructured record"}],
+    }
+
+
+def clean_query(prompt: str) -> str:
+    """`search` refuses control characters (a newline is one) and untrimmed edges. This
+    replaces each control character with a space and collapses whitespace runs. It touches
+    the QUERY only -- the prompt handed back to the agent is never altered."""
+    text = "".join(" " if unicodedata.category(ch) == "Cc" else ch for ch in prompt)
+    return " ".join(text.split())
+
+
+def bound_query(query: str, bound: int, keep: str) -> str:
+    """Cut `query` to at most `bound` UTF-8 bytes on a character and word boundary.
+
+    `keep="tail"` keeps the END of the prompt. The harness builds its prompt as BACKGROUND
+    then PROBLEM, so the end is where the question is; the head of a long prompt is LaTeX
+    preamble. `keep="head"` is the other choice, kept selectable so a run states which it used.
+    """
+    raw = query.encode("utf-8")
+    if len(raw) <= bound:
+        return query
+    if keep == "tail":
+        piece = raw[-bound:].decode("utf-8", errors="ignore")
+        if raw[-bound - 1:-bound] != b" " and " " in piece:
+            piece = piece.split(" ", 1)[1]
+    else:
+        piece = raw[:bound].decode("utf-8", errors="ignore")
+        if raw[bound:bound + 1] != b" " and " " in piece:
+            piece = piece.rsplit(" ", 1)[0]
+    return piece.strip()
+
+
+class KscopeMemorySystem:
+    _query_bound: Optional[int] = None  # learned once per process from the first refusal
+
+    def __init__(
+        self,
+        user_id: str,
+        writer: str = "kscope",
+        run_id: Optional[str] = None,
+        top_k: int = 10,
+        maximum_context_bytes: int = 32768,
+    ):
+        if writer not in ("kscope", "none"):
+            raise ValueError(f"writer must be 'kscope' or 'none', got {writer!r}")
+        run_id = run_id or os.environ.get("BENCH_RUN_ID") or ""
+        for label, value in (("run_id (BENCH_RUN_ID)", run_id), ("user_id", str(user_id or ""))):
+            if not _SAFE_COMPONENT.match(value):
+                raise ValueError(f"kscope adapter: {label} must be a safe path component, got {value!r}")
+        self.user_id = str(user_id)
+        self.writer = writer
+        self.run_id = run_id
+        self.top_k = top_k
+        self.maximum_context_bytes = maximum_context_bytes
+        self.query_keep = os.environ.get("KSCOPE_ARENA_QUERY_KEEP", "tail")
+        if self.query_keep not in ("tail", "head"):
+            raise ValueError("KSCOPE_ARENA_QUERY_KEEP must be 'tail' or 'head'")
+        self.log_path = BENCH_ROOT / "logs" / f"arena_adapter-{run_id}.jsonl"
+        self.root = kscope_io.VAULTS / "arena" / run_id / writer / self.user_id
+        # Refuses reuse: a second initialise for the same user_id is an error, not a shared vault.
+        self.vault = kscope_io.Vault.create(self.root, profile="shipped")
+        self.counters = {
+            "chunks_in": 0, "accepted": 0, "refused": 0, "extraction_failures": 0,
+            "fallback_stored": 0, "lost": 0, "dropped_by_design": 0,
+            "searches": 0, "search_failures": 0, "query_truncated": 0, "abstained": 0,
+            "served_counts": [], "omission_reasons": Counter(), "stop_reasons": Counter(),
+        }
+        self._log({"op": "init", "profile": self.vault.profile, "top_k": top_k,
+                   "maximum_context_bytes": maximum_context_bytes, "query_keep": self.query_keep,
+                   "writer_prompt_sha": delta_writer.prompt_sha() if writer == "kscope" else None})
+
+    # ------------------------------------------------------------------ log
+    def _log(self, row: dict) -> None:
+        counters = dict(self.counters)
+        counters["omission_reasons"] = dict(self.counters["omission_reasons"])
+        counters["stop_reasons"] = dict(self.counters["stop_reasons"])
+        counters["served_counts"] = list(self.counters["served_counts"])
+        base = {"ts": round(time.time(), 3), "run_id": self.run_id, "writer": self.writer,
+                "user_id": self.user_id, "root": str(self.root)}
+        base.update(row)
+        base["counters"] = counters
+        line = json.dumps(base, ensure_ascii=False)
+        for name in ("AZURE_OPENAI_ENDPOINT", "AZURE_OPENAI_API_KEY"):  # an exception's text is logged
+            secret = os.environ.get(name, "").rstrip("/")
+            if secret:
+                line = line.replace(secret, "<redacted>").replace(secret.split("://", 1)[-1], "<redacted>")
+        self.log_path.parent.mkdir(parents=True, exist_ok=True)
+        with open(self.log_path, "a", encoding="utf-8") as handle:
+            handle.write(line + "\n")
+
+    # ----------------------------------------------------------- write door
+    def add_chunk(self, chunk: str):
+        started = time.time()
+        self.counters["chunks_in"] += 1
+        row = {"op": "add_chunk", "chunk_index": self.counters["chunks_in"] - 1,
+               "chunk_sha": _sha(chunk), "chunk_bytes": len(chunk.encode("utf-8")), "chunk": chunk}
+        if self.writer == "none":
+            self.counters["dropped_by_design"] += 1
+            row.update(outcome="dropped_by_design", ms=int((time.time() - started) * 1000))
+            self._log(row)
+            return {"stored": False, "writer": "none"}
+
+        delta, stats, error = None, {}, None
+        try:
+            delta, stats = delta_writer.extract(chunk, tag=f"{self.run_id}/{self.writer}/{self.user_id[:8]}")
+        except llm.BudgetExceeded:
+            raise  # the spend cap is never an "extraction failure"
+        except Exception as exc:  # a writer that raised still must not lose the chunk
+            error = f"{type(exc).__name__}: {str(exc)[:300]}"
+        row["extract"] = {**stats, "error": error}
+        used_fallback = delta is None
+        if used_fallback:
+            self.counters["extraction_failures"] += 1
+            item = {"content_md": chunk, "semantic_delta": fallback_delta(chunk)}
+        else:
+            item = delta_writer.to_item(chunk, delta)
+            row["delta"] = {"memory_type": item["semantic_delta"].get("memory_type"),
+                            "title": item["semantic_delta"].get("title"),
+                            "facts": len(item["semantic_delta"].get("facts") or []),
+                            "entities": len(item["semantic_delta"].get("entities") or []),
+                            "propose": len(item["semantic_delta"].get("propose") or [])}
+
+        stored, memory_id, refusal = self._remember(item)
+        if not stored and not used_fallback:
+            # kscope refused the writer's delta. Count it, keep the reason, and store the
+            # chunk under the fallback delta so the unit is not silently lost.
+            self.counters["refused"] += 1
+            row["refusal"] = refusal
+            used_fallback = True
+            stored, memory_id, second = self._remember({"content_md": chunk, "semantic_delta": fallback_delta(chunk)})
+            if not stored:
+                row["fallback_refusal"] = second
+        elif not stored:
+            self.counters["refused"] += 1
+            row["refusal"] = refusal
+        if stored:
+            self.counters["accepted"] += 1
+            if used_fallback:
+                self.counters["fallback_stored"] += 1
+        else:
+            self.counters["lost"] += 1
+        row.update(outcome="stored" if stored else "lost", fallback=used_fallback, memory_id=memory_id,
+                   ms=int((time.time() - started) * 1000))
+        self._log(row)
+        return {"stored": stored, "fallback": used_fallback, "memory_id": memory_id}
+
+    def _remember(self, item: dict) -> Tuple[bool, Optional[str], Optional[str]]:
+        rc, body, stderr = self.vault.remember_items([item])
+        body = body or {}
+        results = body.get("results") or []
+        first = results[0] if results and isinstance(results[0], dict) else {}
+        if rc == 0 and body.get("accepted_items") == 1:
+            return True, first.get("memory_id"), None
+        reason = first.get("reason") or first.get("message") or body.get("message") or (stderr or "").strip()
+        return False, None, f"rc={rc} status={body.get('status') or first.get('status')} {str(reason)[:500]}"
+
+    # ------------------------------------------------------------ read door
+    def wrap_user_prompt(self, prompt: str) -> str:
+        served = self._search(prompt) if self.writer == "kscope" else self._no_search(prompt)
+        lines = ["<memory_context>"]
+        if served:
+            lines.extend(f"<memory>{text}</memory>" for text in served)
+        else:
+            lines.append("None")
+        lines.append("</memory_context>")
+        lines.append(f"User: {prompt}")
+        return "\n".join(lines)
+
+    def _no_search(self, prompt: str) -> List[str]:
+        self._log({"op": "wrap_user_prompt", "prompt_sha": _sha(prompt),
+                   "prompt_bytes": len(prompt.encode("utf-8")), "served": 0, "outcome": "none_by_design"})
+        return []
+
+    def _search(self, prompt: str) -> List[str]:
+        started = time.time()
+        cls = type(self)
+        self.counters["searches"] += 1
+        cleaned = clean_query(prompt)
+        row = {"op": "wrap_user_prompt", "prompt_sha": _sha(prompt), "prompt_bytes": len(prompt.encode("utf-8")),
+               "cleaned_query_bytes": len(cleaned.encode("utf-8")), "query_keep": self.query_keep}
+        query, body, failure = cleaned, None, None
+        if not cleaned:
+            failure = "empty query after cleaning"
+        else:
+            if cls._query_bound is not None:
+                query = bound_query(cleaned, cls._query_bound, self.query_keep)
+            rc, body, stderr = self.vault.search(query, self.top_k, self.maximum_context_bytes)
+            refusal = ((body or {}).get("message") or stderr or "")
+            learned = _QUERY_BOUND.search(refusal) if rc != 0 else None
+            if learned:
+                # The first over-long query is refused once; the bound is the binary's own number.
+                cls._query_bound = int(learned.group(1))
+                row["bound_learned_from_refusal"] = cls._query_bound
+                query = bound_query(cleaned, cls._query_bound, self.query_keep)
+                rc, body, stderr = self.vault.search(query, self.top_k, self.maximum_context_bytes)
+                refusal = ((body or {}).get("message") or stderr or "")
+            if rc != 0 or not isinstance(body, dict) or "selected_hits" not in body:
+                failure = f"rc={rc} {str(refusal)[:300]}"
+        truncated = query != cleaned
+        if truncated:
+            self.counters["query_truncated"] += 1
+        row.update(query=query, query_bytes=len(query.encode("utf-8")), query_truncated=truncated,
+                   query_bytes_dropped=len(cleaned.encode("utf-8")) - len(query.encode("utf-8")))
+        if failure:
+            self.counters["search_failures"] += 1
+            self.counters["served_counts"].append(0)
+            row.update(outcome="search_failed", failure=failure, served=0, ms=int((time.time() - started) * 1000))
+            self._log(row)
+            return []
+
+        hits = body.get("selected_hits") or []
+        served = [hit.get("content_md") or "" for hit in hits]
+        omissions = Counter((o or {}).get("reason") or "unknown" for o in (body.get("omissions") or []))
+        abstained = bool((body.get("abstention") or {}).get("abstained"))
+        self.counters["served_counts"].append(len(served))
+        self.counters["omission_reasons"].update(omissions)
+        self.counters["stop_reasons"][str(body.get("stop_reason"))] += 1
+        if abstained:
+            self.counters["abstained"] += 1
+        row.update(outcome="served", served=len(served), served_memory_ids=[hit.get("memory_id") for hit in hits],
+                   served_bytes=sum(len(text.encode("utf-8")) for text in served),
+                   omitted_hits=body.get("omitted_hits"), omission_reasons=dict(omissions),
+                   stop_reason=body.get("stop_reason"), abstained=abstained,
+                   served_floor=body.get("served_floor"), exposure_id=body.get("exposure_id"),
+                   context_bytes=body.get("context_bytes"),
+                   # a served memory that itself holds the harness's tags makes math_env.py cut the block short
+                   served_holding_context_tag=sum(1 for text in served if "memory_context>" in text),
+                   ms=int((time.time() - started) * 1000))
+        self._log(row)
+        return served
