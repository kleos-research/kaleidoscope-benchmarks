 from abc import ABC, abstractmethod
 from typing import List, Dict, Any, Optional
+import json
 import os
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+# --- bench patch: every OpenAI-backend request goes through the spend-capped door -------------
+# <bench>/MemoryArena/env/env_systems/formal_reasoning_env/llm_backend.py -> <bench>
+_BENCH_ROOT = Path(os.environ.get("BENCH_ROOT") or Path(__file__).resolve().parents[4])
+if str(_BENCH_ROOT) not in sys.path:
+    sys.path.insert(0, str(_BENCH_ROOT))
+from common import llm as _bench_llm  # noqa: E402
+
+
+class BudgetStop(BaseException):
+    """The spend cap. A BaseException on purpose: the agent wraps its LLM calls in
+    `except Exception` retry loops, and a cap that a retry loop can swallow is not a cap."""
+
+
+def _record_failed_call(role: str, request: dict, seconds: float, exc: BaseException) -> dict:
+    """bench patch: a call that RAISED must leave a row behind.
+
+    `common/llm.py` appends to the ledger only after a response returns, so a request that
+    times out burns minutes of wall clock and writes nothing at all. Worse, `agent/math.py`
+    catches that exception and answers from a path that has no tools, so the run continues
+    and the degraded step is afterwards indistinguishable from one that ran as designed.
+
+    This writes the row shape every existing reader already parses -- `in`, `out` and
+    `est_usd` are 0, so no total moves -- plus `failed`, `error` and `tools`, and appends the
+    same row to `logs/arena_llm_failures.jsonl`.
+    """
+    row = {
+        "ts": round(time.time(), 3), "scope": os.environ.get("BENCH_SCOPE", "unscoped"),
+        "role": role, "tag": os.environ.get("BENCH_TAG", ""),
+        "model_asked": _bench_llm.DEPLOYMENT, "model_served": None,
+        "effort": request.get("reasoning_effort"), "temperature_sent": "temperature" in request,
+        "in": 0, "out": 0, "reasoning": 0,
+        "finish": "error:" + type(exc).__name__, "ms": int(seconds * 1000),
+        "est_usd": 0.0, "price_assumed": [_bench_llm.PRICE_IN, _bench_llm.PRICE_OUT],
+        "failed": True, "error": type(exc).__name__ + ": " + str(exc)[:300],
+        "tools": bool(request.get("tools")),
+        "n_messages": len(request.get("messages") or []),
+    }
+    try:
+        with _bench_llm._locked():
+            with open(_bench_llm.LEDGER, "a") as handle:
+                handle.write(json.dumps(row) + "\n")
+        path = _BENCH_ROOT / "logs" / "arena_llm_failures.jsonl"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with open(path, "a") as handle:
+            handle.write(json.dumps(row) + "\n")
+    except Exception:  # failing to log a failure must not replace the real error
+        pass
+    return row
+
+
+class _GuardedCompletions:
+    def __init__(self, role: str):
+        self._role = role
+
+    def create(self, **request):
+        if request.get("tools"):
+            # The deployment refuses function tools together with reasoning_effort on
+            # /v1/chat/completions ("use /v1/responses or set reasoning_effort to 'none'"), and
+            # common/llm.py speaks chat completions only and defaults the effort to "high". So a
+            # tool-bearing request goes out with effort "none"; requests without tools (the
+            # reasoning tool itself, the final answer, the judge) keep the door's default.
+            request.setdefault("reasoning_effort", "none")
+        started = time.time()
+        try:
+            return _bench_llm.create_raw(request, role=self._role, tag=os.environ.get("BENCH_TAG", ""))
+        except _bench_llm.BudgetExceeded as exc:
+            raise BudgetStop(str(exc)) from exc
+        except BaseException as exc:  # bench patch: record it, then propagate it unchanged
+            _record_failed_call(self._role, request, time.time() - started, exc)
+            raise
+
+
+class GuardedClient:
+    """Stands where `openai.OpenAI(...)` stood. Only `.chat.completions.create` exists, and it
+    hands the harness's request dict, untouched, to `common.llm.create_raw`."""
+
+    def __init__(self, role: str):
+        self.chat = SimpleNamespace(completions=_GuardedCompletions(role))
+# --- end bench patch ---------------------------------------------------------------------------
 
